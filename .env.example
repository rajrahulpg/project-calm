# Settings for the live site. On Hostinger, add each of these as an
# Environment Variable on the Node.js app (see DEPLOYMENT.md). For local
# development, copy this file to .env.local — or skip it entirely: without
# the DB_ values the site uses data/doctor-videos.json instead.

# PIN for the /admin page. Without it, the PIN is 1234 — always set this.
ADMIN_PIN=

# The live address, with no trailing slash. The doctor QR codes link here.
# Read at build time, so redeploy after changing it.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# MySQL database for the doctor videos (Hostinger: Databases > MySQL Databases).
# The table is created and filled with the repo's videos automatically.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
